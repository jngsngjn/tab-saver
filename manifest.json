{
  "manifest_version": 3,

  "name": "로컬용 Tab Saver",
  "description": "__MSG_appDesc__",
  "default_locale": "en",

  "version": "1.0.3",

  "permissions": ["tabs", "storage", "activeTab", "scripting", "favicon"],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "icons": {
    "128": "assets/icon_2.png"
  }
}