{
  "manifest_version": 3,

  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "default_locale": "en",

  "version": "1.0.1",

  "permissions": ["tabs", "storage", "activeTab", "scripting"],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "icons": {
    "128": "assets/icon.png"
  }
}
